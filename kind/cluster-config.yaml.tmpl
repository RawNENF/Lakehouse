apiVersion: kind.x-k8s.io/v1alpha4
kind: Cluster
name: lakehouse

# 1 control-plane + 2 workers = 3 nodes total.
# LOOP0_DEV / LOOP1_DEV / LOOP2_DEV are substituted by scripts/create-loop-devices.sh
# with the actual /dev/loopN device the host assigned — loop device numbers are
# allocated dynamically by the kernel, so this file is a template, not the final config.
nodes:
  - role: control-plane
    extraMounts:
      - hostPath: LOOP0_DEV
        containerPath: /dev/lakehouse-disk0
  - role: worker
    extraMounts:
      - hostPath: LOOP1_DEV
        containerPath: /dev/lakehouse-disk1
  - role: worker
    extraMounts:
      - hostPath: LOOP2_DEV
        containerPath: /dev/lakehouse-disk2

networking:
  apiServerAddress: "127.0.0.1"
  apiServerPort: 6443
